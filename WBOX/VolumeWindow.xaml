<Window x:Class="WBOX.VolumeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WBOX"
        mc:Ignorable="d"
        Title="Volume" Width="100" Height="34" WindowStyle="None" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Topmost="True">
    <Grid>
		<TextBlock Text="Volume" Foreground="Gray" HorizontalAlignment="Center" VerticalAlignment="Top"/>
		<ProgressBar x:Name="volumeBar" Value="50" Height="10" Margin="4,20,4,0" VerticalAlignment="Top"/>
	</Grid>
</Window>
