<Window x:Class="WBOX.AutoLoginManager"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WBOX"
        mc:Ignorable="d"
        Title="Auto Login Manager" Width="400" Height="200" WindowStyle="ToolWindow" WindowStartupLocation="CenterOwner">
    <Grid>
		<StackPanel Orientation="Vertical">
			<StackPanel Orientation="Horizontal" Margin="4">
				<TextBlock Text="Username:" Margin="0,0,4,0" FontSize="24" Foreground="Gray"/>
				<TextBox x:Name="usernameText" Width="256" FontSize="24"/>
			</StackPanel>

			<StackPanel Orientation="Horizontal" Margin="4">
				<TextBlock Text="Password: " Margin="0,0,4,0" FontSize="24" Foreground="Gray"/>
				<PasswordBox x:Name="passwordText" Width="256" FontSize="24"/>
			</StackPanel>
		</StackPanel>

		<TextBlock Text="NOTE: Will ask for UAC 3 times" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="4" Foreground="Orange"/>
		<Button Content="Enable" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="4" Width="100" Height="50" Click="EnableButton_Click"/>
		<Button Content="Disable" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="4" Width="100" Height="50" Click="DisableButton_Click"/>
	</Grid>
</Window>
