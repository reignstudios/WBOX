<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="DarkBackground" Color="#1C1C1C" />
    <SolidColorBrush x:Key="DarkSurface" Color="#252526" />
    <SolidColorBrush x:Key="DarkSurfaceHover" Color="Gray" />
    <SolidColorBrush x:Key="DarkBorder" Color="#3F3F46" />
    <SolidColorBrush x:Key="DarkForeground" Color="#EDEDED" />

    <!-- Window -->
    <Style TargetType="Window">
        <Setter Property="Background" Value="{StaticResource DarkBackground}" />
        <Setter Property="Foreground" Value="{StaticResource DarkForeground}" />
    </Style>

    <Style TargetType="Grid">
        <Setter Property="Background" Value="{StaticResource DarkBackground}" />
    </Style>

    <!-- Button -->
    <Style TargetType="Button">
        <Setter Property="Background" Value="{StaticResource DarkSurface}" />
        <Setter Property="Foreground" Value="{StaticResource DarkForeground}" />
        <Setter Property="BorderBrush" Value="{StaticResource DarkBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Margin" Value="4" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" 
                            BorderBrush="{TemplateBinding BorderBrush}" 
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource DarkSurfaceHover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#003C7A" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- RadioButton -->
    <Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource DarkForeground}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Margin" Value="8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <StackPanel Orientation="Horizontal">
                        <!-- Outer circle -->
                        <Border Width="20" Height="20" 
                                Background="{StaticResource DarkSurface}" 
                                BorderBrush="{StaticResource DarkBorder}" 
                                BorderThickness="2" 
                                CornerRadius="10">
                            <!-- Inner dot -->
                            <Ellipse x:Name="CheckMark" 
                                     Width="10" Height="10" 
                                     Fill="{StaticResource DarkForeground}" 
                                     Visibility="Collapsed" />
                        </Border>
                        <!-- Content -->
                        <ContentPresenter Margin="10,0,0,0" 
                                          VerticalAlignment="Center" 
                                          RecognizesAccessKey="True"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <!-- Checked state -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <!-- Hover effect -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="CheckMark" Property="Fill" Value="#FFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

	<!-- CheckBox -->
	<Style TargetType="CheckBox">
		<Setter Property="Foreground" Value="{StaticResource DarkForeground}" />
		<Setter Property="FontSize" Value="18" />
		<Setter Property="Margin" Value="8" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="CheckBox">
					<StackPanel Orientation="Horizontal">
						<!-- Outer square -->
						<Border Width="20" Height="20" 
                                Background="{StaticResource DarkSurface}" 
                                BorderBrush="{StaticResource DarkBorder}" 
                                BorderThickness="2"
                                CornerRadius="2">
							<!-- Check mark (Path) -->
							<Path x:Name="CheckMark"
                                  Data="M 3.5,10 L 8,14.5 L 16.5,5"
                                  Stroke="{StaticResource DarkForeground}"
                                  StrokeThickness="2.5"
                                  StrokeLineJoin="Round"
                                  Stretch="None"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Visibility="Collapsed" />
						</Border>
						<!-- Content -->
						<ContentPresenter Margin="10,0,0,0" 
                                          VerticalAlignment="Center" 
                                          RecognizesAccessKey="True"/>
					</StackPanel>
					<ControlTemplate.Triggers>
						<!-- Checked state -->
						<Trigger Property="IsChecked" Value="True">
							<Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
						</Trigger>
						<!-- Hover effect -->
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="CheckMark" Property="Stroke" Value="#FFFFFF"/>
						</Trigger>
						<!-- Disabled state -->
						<Trigger Property="IsEnabled" Value="False">
							<Setter Property="Foreground" Value="#888888" />
							<Setter TargetName="CheckMark" Property="Stroke" Value="#888888" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!-- ListBox -->
	<Style TargetType="ListBox">
		<Setter Property="Background" Value="{StaticResource DarkSurface}" />
		<Setter Property="Foreground" Value="{StaticResource DarkForeground}" />
		<Setter Property="BorderBrush" Value="{StaticResource DarkBorder}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="Padding" Value="4" />
		<Setter Property="FontSize" Value="18" />
		<Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
	</Style>

	<!-- TextBox -->
	<Style TargetType="TextBox">
		<Setter Property="Background" Value="{StaticResource DarkSurface}" />
		<Setter Property="Foreground" Value="{StaticResource DarkForeground}" />
		<Setter Property="BorderBrush" Value="{StaticResource DarkBorder}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="Padding" Value="8,6" />
		<Setter Property="FontSize" Value="18" />
		<Setter Property="Margin" Value="4" />
		<Setter Property="VerticalContentAlignment" Value="Center" />
		<Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
		<Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
		<Style.Triggers>
			<!-- Focus effect -->
			<Trigger Property="IsKeyboardFocusWithin" Value="True">
				<Setter Property="BorderBrush" Value="#007ACC" />
				<Setter Property="Background" Value="#2D2D30" />
			</Trigger>
			<!-- Hover effect -->
			<Trigger Property="IsMouseOver" Value="True">
				<Setter Property="BorderBrush" Value="#555555" />
			</Trigger>
			<!-- Disabled state -->
			<Trigger Property="IsEnabled" Value="False">
				<Setter Property="Foreground" Value="#888888" />
				<Setter Property="Background" Value="#1E1E1E" />
			</Trigger>
		</Style.Triggers>
	</Style>

</ResourceDictionary>